<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.upstox.paperlive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/webanatomy/Desktop/upstox_analyzer (2)/web/scripts/run-paper-supervisor.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/webanatomy/Desktop/upstox_analyzer (2)/web</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PORT</key>
        <string>3123</string>
        <key>NODE_ENV</key>
        <string>production</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Monday to Friday at 09:10 IST (03:40 UTC) -->
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>10</integer>
        </dict>
    </array>

    <!-- Do not automatically restart when process exits normally at market close -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- Avoid tight crash restart loops -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/webanatomy/Desktop/upstox_analyzer (2)/web/logs/launchd.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/webanatomy/Desktop/upstox_analyzer (2)/web/logs/launchd.stderr.log</string>
</dict>
</plist>
