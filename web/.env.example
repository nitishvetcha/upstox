# Copy to .env.local. Server-only: none use the NEXT_PUBLIC_ prefix, so Next.js never sends them to the browser.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Upstox developer console.
UPSTOX_REDIRECT_URI=http://localhost:3123/api/auth/callback
NEWS_API_KEY=
# upstox = live data when logged in (falls back to mock otherwise); mock = always mock
MARKET_DATA_PROVIDER=upstox
# Strikes either side of ATM returned by /api/option-chain (default 10)
# OPTION_CHAIN_RANGE=10
