# ─────────────────────────────────────────────────────────────────────────────
# Upstox Options Analyzer — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Upstox read-only access (choose ONE method) ──────────────────────────────
#
# METHOD 1 — Analytics Token (recommended for first-time setup)
# Long-lived (1 year), no OAuth flow, no daily re-login, order endpoints blocked at API level.
# Obtain from: Upstox web → Settings → API Keys → Analytics Token
# When set, this takes priority over the OAuth token below.
# UPSTOX_ANALYTICS_TOKEN=your_analytics_token_here
#
# METHOD 2 — OAuth (required for multi-user or if Analytics Token is unavailable)
# Requires creating an app at https://developer.upstox.com → Your Apps.
# Token expires at 03:30 IST daily; re-login via /api/auth/login each morning.
UPSTOX_CLIENT_ID=your_upstox_client_id_here
UPSTOX_CLIENT_SECRET=your_upstox_client_secret_here
# Redirect URI must exactly match what is registered in your Upstox app
UPSTOX_REDIRECT_URI=http://localhost:3123/api/auth/callback

# ── Token storage ────────────────────────────────────────────────────────────
# Path to the file where the OAuth access token is persisted.
# Default: .data/upstox-token.json (relative to project root)
# UPSTOX_TOKEN_FILE=.data/upstox-token.json

# ── Market data provider ─────────────────────────────────────────────────────
# "upstox" (live, requires valid token) or "mock" (deterministic offline data)
# Default: "upstox" — falls back to mock automatically on auth failure
# MARKET_DATA_PROVIDER=upstox

# ── Account capital (INR) ────────────────────────────────────────────────────
# Used to calculate risk percentages. Does NOT represent broker collateral.
# Default: 500000
# ACCOUNT_CAPITAL=500000

# ── Risk configuration ───────────────────────────────────────────────────────
# Maximum risk per trade as a percentage of ACCOUNT_CAPITAL
# Default: 1.5 (= ₹7,500 on ₹5L capital)
# RISK_PER_TRADE_PERCENT=1.5

# Maximum total open risk as a percentage of ACCOUNT_CAPITAL
# Default: 3.0 (= ₹15,000 on ₹5L capital)
# This is a stop-loss risk BUDGET — not SPAN margin or exchange collateral.
# MAX_OPEN_RISK_PERCENT=3.0

# Maximum concurrent open positions
# Default: 3
# MAX_CONCURRENT_POSITIONS=3

# Maximum allowable daily loss as a percentage of ACCOUNT_CAPITAL
# Default: 2.0
# MAX_DAILY_LOSS_PERCENT=2.0

# ── Option chain ─────────────────────────────────────────────────────────────
# Number of strikes above and below ATM to include in the chain
# Default: 10
# OPTION_CHAIN_RANGE=10

# ── Futures rollover ─────────────────────────────────────────────────────────
# Days before expiry at which futures roll to the next contract
# Default: 3
# FUTURES_ROLLOVER_DAYS=3

# ── Storage directories ──────────────────────────────────────────────────────
# All paths are relative to project root unless absolute.
# Default values shown. Override only in special deployment scenarios.

# Paper-trading ledger storage (used by paperLedgerStore)
# PAPER_TRADES_DIR=.data/paper-trades

# Paper-trading root directory (used by some scripts and the runner)
# PAPER_TRADING_DIR=.data/paper-trading

# Paper opportunity collection storage
# PAPER_OPPORTUNITY_DIR=.data/paper-opportunities

# Session evidence storage (set to a temp dir in tests — REQUIRED)
# SESSION_EVIDENCE_DIR=.data/paper-sessions

# Opportunity tracking records
# OPPORTUNITY_TRACK_DIR=.data/opportunity-tracking

# Recommendation journal storage
# RECOMMENDATION_STORE_DIR=.data/recommendations

# ── Feature flags (both MUST remain false for safety) ────────────────────────
# Live option-quote LTT integration — keep false until fully validated
OPTION_QUOTE_LTT_ENABLED=false

# Option-quote canary diagnostic — keep false by default
OPTION_QUOTE_CANARY_ENABLED=false

# ── News configuration ───────────────────────────────────────────────────────
# Optional: external news API key (RSS feeds work without this)
# NEWS_API_KEY=your_news_api_key_here

# News cache duration in minutes
# NEWS_CACHE_MINUTES=5

# Comma-separated RSS feed URLs (uses built-in defaults if unset)
# NEWS_RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml

# ── Canary configuration ─────────────────────────────────────────────────────
# These are only used when OPTION_QUOTE_CANARY_ENABLED=true (keep false)
# CANARY_AUTH_SECRET=your_canary_secret_here
# CANARY_LOG_DIR=.data/canary-logs

# ── Log directories ───────────────────────────────────────────────────────────
# COLLECTION_LOG_DIR=.data/logs/collection
# MONITOR_LOG_DIR=.data/logs/monitor

# ── Development overrides ────────────────────────────────────────────────────
# Override the current timestamp for deterministic development/testing
# Format: ISO 8601 — e.g. 2026-10-27T04:30:00Z
# FAKE_NOW=

# Override the market status for UI testing
# Values: OPEN | CLOSED | PRE_OPEN | POST_CLOSE
# FAKE_STATUS=

# Enable verbose HTTP request logging to .data/fetch.log
# FETCH_LOG=false

# ── Node / Next.js ───────────────────────────────────────────────────────────
# Set to Asia/Kolkata for correct IST market-session calculations.
# The application and all services expect TZ=Asia/Kolkata in production.
TZ=Asia/Kolkata

# Next.js sets this automatically. Do not set manually.
# NODE_ENV=production
