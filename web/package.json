{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3123",
    "build": "next build --webpack",
    "start": "NODE_OPTIONS='--max-old-space-size=352' next start",
    "lint": "eslint",
    "test": "env -u UPSTOX_ANALYTICS_TOKEN UPSTOX_TOKEN_FILE=.test-data/no-upstox-token.json SESSION_EVIDENCE_DIR=.test-data/paper-sessions PAPER_TRADES_DIR=.test-data/paper-trades PAPER_LEDGER_DB_PATH=.test-data/paper_ledger.db node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "dev:upstox": "node scripts/dev-upstox.mjs",
    "upstox:login": "node scripts/upstox-login.mjs",
    "upstox:status": "node scripts/upstox-status.mjs",
    "paper:collect": "node scripts/paper-collect.mjs",
    "paper:evaluate": "node scripts/paper-evaluate.mjs",
    "paper:cycle": "node scripts/paper-cycle.mjs",
    "paper:live": "node scripts/paper-live.mjs",
    "bot:runner": "node --import tsx --env-file=.env.local scripts/run-telegram-market-bot.ts",
    "start:render": "NODE_OPTIONS='--max-old-space-size=352' node scripts/start-render.mjs",
    "data:ingest": "node --import tsx scripts/ingest-underlying-history.ts",
    "backtest:replay": "node --import tsx scripts/run-contract-replay.ts",
    "validate:walk-forward": "node --import tsx scripts/run-walk-forward-validation.ts",
    "typecheck": "tsc --noEmit",
    "preflight": "tsc --noEmit && npm test && npm run build",
    "test:dom": "node --import tsx --test src/app/saved-picks/savedPicks.dom.test.tsx",
    "test:integration": "node --import tsx --test src/lib/integration/openRoute.integration.ts src/lib/integration/openRouteSuccess.integration.ts src/lib/integration/openRouteLedgerFailure.integration.ts src/lib/integration/openRouteParallel.integration.ts src/lib/integration/securityRegression.integration.ts"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^1.52.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "protobufjs": "8.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
