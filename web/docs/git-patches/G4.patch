diff --git a/tests/browser/chain-selection.probe.mjs b/tests/browser/chain-selection.probe.mjs
new file mode 100644
index 00000000..474ab51c
--- /dev/null
+++ b/tests/browser/chain-selection.probe.mjs
@@ -0,0 +1,33 @@
+// Probe: can a user select a strike or contract on the option-chain page? Loopback, synthetic token, mock data only.
+// Usage: node tests/browser/chain-selection.probe.cjs <base-url> <operator-token>
+import { chromium } from "playwright";
+// Connection and credential come from the environment only. Nothing is read from positional arguments.
+const BASE = "http://127.0.0.1:3150"; // local test server only
+const TOKEN = process.env.PAPER_OPERATOR_CREDENTIAL ?? ""; // operator PIN for the local app (never printed)
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+  await ctx.route("**/*", (r) => (r.request().url().startsWith(BASE) || r.request().url().startsWith("data:")) ? r.continue() : r.abort());
+  const page = await ctx.newPage();
+  await page.goto(BASE + "/login", { waitUntil: "load", timeout: 120000 });
+  await page.fill("input[name=pin]", TOKEN);
+  await Promise.all([page.waitForURL((u) => !new URL(u).pathname.startsWith("/login"), { timeout: 60000 }), page.click("button[type=submit]")]);
+  await page.goto(BASE + "/option-chain", { waitUntil: "load", timeout: 120000 });
+  await page.waitForTimeout(2000);
+  const info = await page.evaluate(() => {
+    const rows = [...document.querySelectorAll("table tbody tr")];
+    const first = rows[0];
+    return {
+      rowCount: rows.length,
+      rowHasButton: rows.filter((r) => r.querySelector("button, a, [role=button], input[type=radio]")).length,
+      rowClickable: rows.filter((r) => r.onclick !== null || r.getAttribute("role") === "button").length,
+      selects: [...document.querySelectorAll("select")].map((s) => ({ name: s.name, options: [...s.options].map((o) => o.textContent.trim()).slice(0, 8) })),
+      tabs: [...document.querySelectorAll("button")].map((b) => b.textContent.trim()).filter((t) => /^(NIFTY|BANKNIFTY|FINNIFTY|MIDCPNIFTY|SENSEX|BANKEX)$/.test(t)),
+      contractDetailPanel: /Contract details|Selected contract|lot size/i.test(document.body.innerText),
+      firstRowText: first ? first.innerText.replace(/\s+/g, " ").slice(0, 160) : null,
+    };
+  });
+  console.log("PROBE_RESULT " + JSON.stringify(info));
+  await browser.close();
+})().catch((e) => { console.error("PROBE_ERROR " + e.message.slice(0, 200)); process.exit(1); });
diff --git a/tests/browser/contract-scenarios.check.mjs b/tests/browser/contract-scenarios.check.mjs
new file mode 100644
index 00000000..13523312
--- /dev/null
+++ b/tests/browser/contract-scenarios.check.mjs
@@ -0,0 +1,92 @@
+// Browser scenarios for informational contract selection: metadata, quantity, expiry reset, stale and error states.
+// Loopback only, MOCK data. The stale and error cases alter only the browser's copy of the response (route.fulfill), labelled below.
+// Usage: node tests/browser/contract-scenarios.check.cjs <base-url> <operator-token> <screenshot-dir>
+import { chromium } from "playwright";
+
+// Connection and credential come from the environment only. Nothing is read from positional arguments.
+const BASE = "http://127.0.0.1:3150"; // local test server only
+const TOKEN = process.env.PAPER_OPERATOR_CREDENTIAL ?? ""; // operator PIN for the local app (never printed)
+const SHOTS = process.env.BROWSER_SHOTS_DIR ?? ".";
+const results = [];
+const rec = (name, ok, detail = "") => { results.push({ name, ok, detail }); console.log((ok ? "PASS " : "FAIL ") + name + (detail ? " :: " + detail : "")); };
+const panel = (page) => page.innerText("section[aria-label='Selected contract']");
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  for (const [label, w, h] of [["desktop", 1440, 900], ["mobile", 390, 844]]) {
+    const ctx = await browser.newContext({ viewport: { width: w, height: h } });
+    await ctx.route("**/*", (r) => (r.request().url().startsWith(BASE) || r.request().url().startsWith("data:")) ? r.continue() : r.abort());
+    const page = await ctx.newPage();
+    const pageErrors = [];
+    page.on("pageerror", (e) => pageErrors.push(e.message.slice(0, 120)));
+    await page.goto(BASE + "/login", { waitUntil: "load", timeout: 120000 });
+    await page.fill("input[name=pin]", TOKEN);
+    await Promise.all([page.waitForURL((u) => !new URL(u).pathname.startsWith("/login"), { timeout: 60000 }), page.click("button[type=submit]")]);
+    await page.goto(BASE + "/option-chain?index=nifty", { waitUntil: "load", timeout: 120000 });
+    await page.waitForSelector("table[aria-label='Option chain'] tbody tr", { timeout: 60000 });
+    const tag = label;
+
+    // 1. Metadata: lot size from backend, instrument key from backend (not "Not provided").
+    await page.click("button[aria-label='Select CE 24850']");
+    let t = await panel(page);
+    rec(`${tag} lot size from backend snapshot shown`, /Lot size\s*65\b/.test(t), t.replace(/\s+/g, " ").slice(0, 200));
+    rec(`${tag} instrument key from backend shown`, /Instrument key\s*MOCK_FO\|/.test(t));
+
+    // 2. Quantity = lots x lot size, from backend lot size.
+    await page.fill("input[type=number]", "3");
+    t = await panel(page);
+    rec(`${tag} quantity = 3 x 65 = 195`, /Quantity:\s*195\b/.test(t));
+
+    // 3. Expiry change resets selection and loads the chosen expiry's chain.
+    const expiries = await page.$$eval("select[aria-label='Expiry'] option", (o) => o.map((x) => x.value));
+    rec(`${tag} two backend expiries offered`, expiries.length === 2, JSON.stringify(expiries));
+    const second = expiries[1];
+    await page.selectOption("select[aria-label='Expiry']", second);
+    await page.waitForFunction((e) => document.querySelector("select[aria-label='Expiry']").value === e, second, { timeout: 30000 });
+    await page.waitForFunction(() => !document.body.innerText.includes("Loading expiry"), null, { timeout: 30000 });
+    t = await panel(page);
+    rec(`${tag} expiry change clears contract selection`, /No contract selected/.test(t));
+    const pressed = await page.$$eval("button[aria-pressed=true]", (b) => b.length);
+    rec(`${tag} expiry change clears pressed state`, pressed === 0, "pressed=" + pressed);
+    const hdr = await page.$$eval("table[aria-label='Option chain'] tbody tr", (r) => r.length);
+    rec(`${tag} 31 rows after expiry change`, hdr === 31, "rows=" + hdr);
+
+    // 4. Selecting again on the new expiry shows the new expiry and the same lot size (backend-supplied).
+    await page.click("button[aria-label='Select PE 24850']");
+    t = await panel(page);
+    rec(`${tag} new expiry selection shows that expiry`, t.includes(second), t.replace(/\s+/g, " ").slice(0, 160));
+
+    // 5. Stale provenance: backend returns a fallback message for this expiry (browser-side copy of the response).
+    await page.route("**/api/option-chain/nifty?*", async (route) => {
+      const resp = await route.fetch();
+      const j = await resp.json();
+      j.source = "STALE";
+      j.fallbackMessage = "Option chain is stale (test fixture). Prices may be out of date.";
+      await route.fulfill({ response: resp, json: j });
+    });
+    await page.selectOption("select[aria-label='Expiry']", expiries[0]);
+    await page.waitForFunction(() => !document.body.innerText.includes("Loading expiry"), null, { timeout: 30000 });
+    const stale = await page.innerText("body");
+    rec(`${tag} stale fallback message shown`, /Option chain is stale/.test(stale));
+    await page.unroute("**/api/option-chain/nifty?*");
+
+    // 6. Error: backend fails for the next expiry; nothing is selected and the old chain stays.
+    await page.route("**/api/option-chain/nifty?*", (route) => route.fulfill({ status: 500, json: { error: "fixture failure" } }));
+    await page.selectOption("select[aria-label='Expiry']", expiries[1]);
+    await page.waitForSelector("[role=alert]", { timeout: 30000 });
+    const err = await page.innerText("[role=alert]");
+    rec(`${tag} error shown with nothing selected`, /Could not load expiry/.test(err) && /Nothing is selected/.test(err), err.slice(0, 120));
+    rec(`${tag} old chain kept after failed expiry load`, (await page.$$eval("table[aria-label='Option chain'] tbody tr", (r) => r.length)) === 31);
+    await page.unroute("**/api/option-chain/nifty?*");
+
+    if (label === "desktop") await page.screenshot({ path: `${SHOTS}/scenarios-desktop.png` });
+    else await page.screenshot({ path: `${SHOTS}/scenarios-mobile.png` });
+
+    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
+    rec(`${tag} no horizontal overflow`, overflow === 0, "overflowPx=" + overflow);
+    rec(`${tag} no page errors`, pageErrors.length === 0, pageErrors.join(" | "));
+    await ctx.close();
+  }
+  await browser.close();
+  console.log("SUMMARY", results.filter((r) => r.ok).length, "pass,", results.filter((r) => !r.ok).length, "fail");
+})().catch((e) => { console.error("HARNESS_ERROR", e.message.slice(0, 300)); process.exit(1); });
diff --git a/tests/browser/contract-selection.check.mjs b/tests/browser/contract-selection.check.mjs
new file mode 100644
index 00000000..a1e8ed82
--- /dev/null
+++ b/tests/browser/contract-selection.check.mjs
@@ -0,0 +1,81 @@
+// Browser check: informational contract selection on the option-chain page. Loopback only, mock data, no orders.
+// Usage: node tests/browser/contract-selection.check.cjs <base-url> <operator-token> <screenshot-dir>
+import { chromium } from "playwright";
+
+// Connection and credential come from the environment only. Nothing is read from positional arguments.
+const BASE = "http://127.0.0.1:3150"; // local test server only
+const TOKEN = process.env.PAPER_OPERATOR_CREDENTIAL ?? ""; // operator PIN for the local app (never printed)
+const SHOTS = process.env.BROWSER_SHOTS_DIR ?? ".";
+const results = [];
+const rec = (name, ok, detail = "") => { results.push({ name, ok, detail }); console.log((ok ? "PASS " : "FAIL ") + name + (detail ? " :: " + detail : "")); };
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  for (const [label, w, h] of [["desktop", 1440, 900], ["tablet", 768, 1024], ["mobile", 390, 844]]) {
+    const ctx = await browser.newContext({ viewport: { width: w, height: h } });
+    await ctx.route("**/*", (r) => (r.request().url().startsWith(BASE) || r.request().url().startsWith("data:")) ? r.continue() : r.abort());
+    const page = await ctx.newPage();
+    const pageErrors = [];
+    page.on("pageerror", (e) => pageErrors.push(e.message.slice(0, 120)));
+    await page.goto(BASE + "/login", { waitUntil: "load", timeout: 120000 });
+    await page.fill("input[name=pin]", TOKEN);
+    await Promise.all([page.waitForURL((u) => !new URL(u).pathname.startsWith("/login"), { timeout: 60000 }), page.click("button[type=submit]")]);
+
+    for (const idx of ["nifty", "banknifty"]) {
+      await page.goto(BASE + "/option-chain?index=" + idx, { waitUntil: "load", timeout: 120000 });
+      await page.waitForSelector("table[aria-label='Option chain'] tbody tr", { timeout: 60000 });
+      const tag = `${label} ${idx}`;
+      const rowCount = await page.$$eval("table[aria-label='Option chain'] tbody tr", (r) => r.length);
+      rec(`${tag} 31-row display`, rowCount === 31, "rows=" + rowCount);
+
+      const panelBefore = await page.innerText("section[aria-label='Selected contract']");
+      rec(`${tag} no selection by default`, /No contract selected/.test(panelBefore));
+
+      // CE and PE at two different strikes; each click must change only its own side.
+      const strikes = await page.$$eval("table[aria-label='Option chain'] tbody tr", (rows) => rows.map((r) => r.querySelector("td.text-center").firstChild.textContent.trim()));
+      const s1 = strikes[10], s2 = strikes[20];
+      await page.click(`button[aria-label='Select CE ${s1.replace(/,/g, "")}']`);
+      let panel = await page.innerText("section[aria-label='Selected contract']");
+      rec(`${tag} CE selection shows CE`, /Option type\s*CE/.test(panel), panel.replace(/\s+/g, " ").slice(0, 140));
+      await page.click(`button[aria-label='Select PE ${s2.replace(/,/g, "")}']`);
+      panel = await page.innerText("section[aria-label='Selected contract']");
+      rec(`${tag} PE selection replaces it with PE`, /Option type\s*PE/.test(panel) && /Strike\s*\S+/.test(panel));
+      const pressed = await page.$$eval("button[aria-pressed=true]", (b) => b.length);
+      rec(`${tag} only one contract active`, pressed === 1, "pressed=" + pressed);
+
+      // Lots and quantity: quantity only when lot size is present in the backend data.
+      const lotText = await page.innerText("section[aria-label='Selected contract']");
+      const lotUnavailable = /Lot size\s*Unavailable/.test(lotText);
+      if (lotUnavailable) {
+        rec(`${tag} lot size unavailable is shown, quantity not invented`, /Quantity: Unavailable/.test(lotText));
+      } else {
+        const m = lotText.match(/Lot size\s*(\d+)/);
+        await page.fill("input[type=number]", "3");
+        const after = await page.innerText("section[aria-label='Selected contract']");
+        rec(`${tag} quantity = 3 x lot size`, m && new RegExp("Quantity: " + (3 * Number(m[1]))).test(after));
+      }
+      await page.fill("input[type=number]", "0");
+      const bad = await page.innerText("section[aria-label='Selected contract']");
+      rec(`${tag} invalid lots rejected`, /Lots must be a whole number/.test(bad));
+      await page.fill("input[type=number]", "1");
+
+      const expiryOpts = await page.$$eval("select[aria-label='Expiry'] option", (o) => o.map((x) => x.value));
+      rec(`${tag} expiry options from backend (>=1)`, expiryOpts.length >= 1, JSON.stringify(expiryOpts.slice(0, 4)));
+      if (expiryOpts.length > 1) {
+        await page.selectOption("select[aria-label='Expiry']", expiryOpts[1]);
+        await page.waitForFunction((e) => document.querySelector("select[aria-label='Expiry']").value === e, expiryOpts[1], { timeout: 30000 });
+        const reset = await page.innerText("section[aria-label='Selected contract']");
+        rec(`${tag} expiry change resets selection`, /No contract selected/.test(reset));
+      }
+      if (label === "desktop") await page.screenshot({ path: `${SHOTS}/contract-${idx}-desktop.png`, fullPage: false });
+      if (label === "mobile" && idx === "nifty") await page.screenshot({ path: `${SHOTS}/contract-${idx}-mobile.png`, fullPage: false });
+    }
+
+    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
+    rec(`${label} no page horizontal overflow`, overflow === 0, "overflowPx=" + overflow);
+    rec(`${label} no page errors`, pageErrors.length === 0, pageErrors.join(" | "));
+    await ctx.close();
+  }
+  await browser.close();
+  console.log("SUMMARY", results.filter((r) => r.ok).length, "pass,", results.filter((r) => !r.ok).length, "fail");
+})().catch((e) => { console.error("HARNESS_ERROR", e.message.slice(0, 300)); process.exit(1); });
diff --git a/tests/browser/csp-measure.check.mjs b/tests/browser/csp-measure.check.mjs
new file mode 100644
index 00000000..e799df1e
--- /dev/null
+++ b/tests/browser/csp-measure.check.mjs
@@ -0,0 +1,41 @@
+// Measurement only: loads pages under the REPORT-ONLY nonce CSP and records every securitypolicyviolation event.
+// Enforcement is not enabled by this script. Mock server, loopback only.
+// Usage: node tests/browser/csp-measure.check.cjs <base-url> <pin> <screenshot-dir>
+import { chromium } from "playwright";
+// Connection and credential come from the environment only. Nothing is read from positional arguments.
+const BASE = "http://127.0.0.1:3150"; // local test server only
+const PIN = process.env.PAPER_OPERATOR_CREDENTIAL ?? ""; // operator PIN for the local app (never printed)
+const SHOTS = process.env.BROWSER_SHOTS_DIR ?? ".";
+const PAGES = ["/", "/saved-picks", "/option-chain?index=nifty", "/option-chain?index=banknifty", "/recommendations", "/strategies", "/change-pin", "/opportunities", "/stock-v2", "/options-research", "/market-history", "/strategy-evidence", "/performance"];
+
+(async () => {
+  const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME_PATH || undefined });
+  const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+  await ctx.route("**/*", (r) => (r.request().url().startsWith(BASE) || r.request().url().startsWith("data:")) ? r.continue() : r.abort());
+  const page = await ctx.newPage();
+  const violations = [];
+  await page.exposeFunction("__cspReport", (v) => violations.push(v));
+  await page.addInitScript(() => {
+    document.addEventListener("securitypolicyviolation", (e) => {
+      window.__cspReport({ page: location.pathname, directive: e.violatedDirective, blocked: (e.blockedURI || "").slice(0, 80), sample: (e.sample || "").slice(0, 60) });
+    });
+  });
+  await page.goto(BASE + "/login", { waitUntil: "load", timeout: 120000 });
+  await page.fill("input[name=pin]", PIN);
+  await Promise.all([page.waitForURL((u) => !new URL(u).pathname.startsWith("/login"), { timeout: 60000 }), page.click("button[type=submit]")]);
+  for (const p of PAGES) {
+    await page.goto(BASE + p, { waitUntil: "load", timeout: 120000 });
+    await page.waitForTimeout(1200);
+  }
+  const counts = {};
+  for (const v of violations) {
+    const key = `${v.directive} | ${v.blocked}`;
+    counts[key] = (counts[key] || 0) + 1;
+  }
+  console.log("PAGES_CHECKED", PAGES.length);
+  console.log("VIOLATION_EVENTS", violations.length);
+  for (const smp of [...new Set(violations.map((v) => v.page + " :: " + v.sample))].slice(0, 6)) console.log("SAMPLE", smp);
+  for (const [k, n] of Object.entries(counts).sort((a, b) => b[1] - a[1])) console.log("COUNT", n, k);
+  await page.screenshot({ path: `${SHOTS}/csp-measure-dashboard.png`, fullPage: false });
+  await browser.close();
+})().catch((e) => { console.error("HARNESS_ERROR", e.message.slice(0, 300)); process.exit(1); });
diff --git a/tests/browser/journal-filters.check.mjs b/tests/browser/journal-filters.check.mjs
new file mode 100644
index 00000000..f11fbc57
--- /dev/null
+++ b/tests/browser/journal-filters.check.mjs
@@ -0,0 +1,58 @@
+// Browser check: recommendation journal filter buttons. Mock server, loopback only. No live calls.
+// Usage: node tests/browser/journal-filters.check.cjs <base-url> <operator-token>
+import { chromium } from "playwright";
+// Connection and credential come from the environment only. Nothing is read from positional arguments.
+const BASE = "http://127.0.0.1:3150"; // local test server only
+const TOKEN = process.env.PAPER_OPERATOR_CREDENTIAL ?? ""; // operator PIN for the local app (never printed)
+const results = [];
+const rec = (name, ok, detail = "") => { results.push({ name, ok, detail }); console.log((ok ? "PASS " : "FAIL ") + name + (detail ? " :: " + detail : "")); };
+
+// The journal's filter buttons sit in the journal panel on the home page.
+// Scoped to the journal panel (the smallest container that holds "Journal Summary"), so other pages' buttons are ignored.
+const journal = (page) => page.locator("section").filter({ has: page.locator("h3", { hasText: "Journal Summary" }) }).first();
+const filterBtn = (page, text) => journal(page).locator("button", { hasText: new RegExp("^\\s*" + text + "\\s*$") }).first();
+const pressed = (page, text) => filterBtn(page, text).getAttribute("aria-pressed");
+
+(async () => {
+  const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROME_PATH || undefined });
+  for (const [label, w, h] of [["desktop", 1440, 900], ["mobile", 390, 844]]) {
+    const ctx = await browser.newContext({ viewport: { width: w, height: h } });
+    await ctx.route("**/*", (r) => (r.request().url().startsWith(BASE) || r.request().url().startsWith("data:")) ? r.continue() : r.abort());
+    const page = await ctx.newPage();
+    const pageErrors = [];
+    page.on("pageerror", (e) => pageErrors.push(e.message.slice(0, 120)));
+    await page.goto(BASE + "/login", { waitUntil: "load", timeout: 120000 });
+    await page.fill("input[name=pin]", TOKEN);
+    await Promise.all([page.waitForURL((u) => !new URL(u).pathname.startsWith("/login"), { timeout: 60000 }), page.click("button[type=submit]")]);
+    await page.goto(BASE + "/", { waitUntil: "load", timeout: 120000 });
+    await page.waitForSelector("text=Journal Summary", { timeout: 60000 });
+
+    // Defaults: underlying All, decision All, days 7d.
+    rec(`${label} default: All underlying pressed`, (await pressed(page, "All")) !== null);
+    rec(`${label} default: 7d range pressed`, (await pressed(page, "7d")) === "true", "aria-pressed=" + (await pressed(page, "7d")));
+
+    // Underlying: NIFTY pressed, All not pressed.
+    await filterBtn(page, "NIFTY").click();
+    rec(`${label} click NIFTY: NIFTY becomes pressed`, (await pressed(page, "NIFTY")) === "true");
+    rec(`${label} click NIFTY: BANKNIFTY is not pressed`, (await pressed(page, "BANKNIFTY")) === "false");
+
+    // Decision: TRADE pressed, one at a time.
+    await filterBtn(page, "TRADE").click();
+    rec(`${label} click TRADE: TRADE pressed`, (await pressed(page, "TRADE")) === "true");
+    rec(`${label} click TRADE: WAIT not pressed`, (await pressed(page, "WAIT")) === "false");
+
+    // Days: Today, then All Time.
+    await filterBtn(page, "Today").click();
+    rec(`${label} click Today: Today pressed, 7d not`, (await pressed(page, "Today")) === "true" && (await pressed(page, "7d")) === "false");
+    await filterBtn(page, "All Time").click();
+    rec(`${label} click All Time: All Time pressed`, (await pressed(page, "All Time")) === "true");
+
+    // Filters never produce an application error, and the empty/list message is still shown.
+    const txt = await page.innerText("body");
+    rec(`${label} journal still renders after filtering`, /Journal Summary/.test(txt) && !/Application error/i.test(txt));
+    rec(`${label} no page errors during filtering`, pageErrors.length === 0, pageErrors.join(" | "));
+    await ctx.close();
+  }
+  await browser.close();
+  console.log("SUMMARY", results.filter((r) => r.ok).length, "pass,", results.filter((r) => !r.ok).length, "fail");
+})().catch((e) => { console.error("HARNESS_ERROR", e.message.slice(0, 300)); process.exit(1); });
